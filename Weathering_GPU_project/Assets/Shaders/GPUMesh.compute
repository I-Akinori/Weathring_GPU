#pragma kernel PBD_StartFrame
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void PBD_StartFrame
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    // Add force
    _VertBufferRW[P_ID].vel += _VertBufferRW[P_ID].frc * abs(_delta_time) * _VertBufferRW[P_ID].w;
    // Attenuate velocity
    _VertBufferRW[P_ID].vel *= 0.00;
    // Assume position
    _VertBufferRW[P_ID].ass = _VertBufferRW[P_ID].pos +_VertBufferRW[P_ID].vel * abs(_delta_time);
    // To Do: Collision
    _VertBufferRW[P_ID].del = float3(0, 0, 0);
    _DeltaPosAsInt[P_ID] = uint3(0, 0, 0);
    _DeltaCount[P_ID] = 0;
}

#pragma kernel PBD_Itteration_L
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void PBD_Itteration_L
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _LConstNum) return;
    if (_LengthConstraintBufferRW[P_ID].thr < 0) return;

    const Vert v0 = _VertBufferRW[_LengthConstraintBufferRW[P_ID].p0];
    const Vert v1 = _VertBufferRW[_LengthConstraintBufferRW[P_ID].p1];
    float3 n01 = v0.ass - v1.ass;
    float C_Val = length(n01) - _LengthConstraintBufferRW[P_ID].offset;
    // reverseがONならoffsetは初期状態に
    //if (_delta_time < 0)
    //    C_Val = length(n01) - _LengthConstraintBufferRW[P_ID].offset0;

    if (abs(C_Val) < _LengthConstraintBufferRW[P_ID].thr) return;

    n01 /= length(n01);
    
    const float w0 = v0.w;
    const float w1 = v1.w;
    const float s0 = (w0 + w1 == 0) ? 0 : w0 / (w0 + w1) * C_Val;
    const float s1 = (w0 + w1 == 0) ? 0 : w1 / (w0 + w1) * C_Val;
    const float k = _LengthConstraintBufferRW[P_ID].stiff == 1.0 ? 1.0 : 1.0 - pow(abs(1.0 - _LengthConstraintBufferRW[P_ID].stiff), 1.0 / (_itr_count + 1));

    AtomicAddDeltaVector(_LengthConstraintBufferRW[P_ID].p0, - s0 * n01 * k);
    AtomicAddDeltaVector(_LengthConstraintBufferRW[P_ID].p1, + s1 * n01 * k);
 }

#pragma kernel PBD_Itteration_B
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void PBD_Itteration_B
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _BConstNum) return;
    if (_BendConstraintBufferRW[P_ID].thr < 0) return;

    const Vert v0 = _VertBufferRW[_BendConstraintBufferRW[P_ID].p0];
    const Vert v1 = _VertBufferRW[_BendConstraintBufferRW[P_ID].p1];
    const Vert v2 = _VertBufferRW[_BendConstraintBufferRW[P_ID].p2];
    const Vert v3 = _VertBufferRW[_BendConstraintBufferRW[P_ID].p3];

    const float3 p = (v0.ass + v1.ass) / 2;
    const float3 n12 = normalize(cross(v2.ass - v0.ass, v1.ass - v0.ass));
    const float3 n13 = normalize(cross(v1.ass - v0.ass, v3.ass - v0.ass));
    const float3 neutral = normalize(n12 + n13);

    const float L0 = length(v2.ass - p);
    const float L1 = length(v3.ass - p);
    const float3 c0 = (v2.ass + 2 * p + (p + L0 * neutral)) / 4;
    const float3 c1 = (v3.ass + 2 * p + (p + L1 * neutral)) / 4;
    
    const float wv0 = v0.w;
    const float wv1 = v1.w;
    const float wb0 = v2.w;
    const float wb1 = v3.w;
    const float wn = 0;

    // 要、重心維持の検討
    const float W0 = wv0 + wv1 + wb0 + wn;
    const float W1 = wv0 + wv1 + wb1 + wn;
    const float W = wv0 + wv1 + wb0 + wb1;

    float offset = _BendConstraintBufferRW[P_ID].offset;
    // reverseがONならoffsetは初期状態に
    //if (_delta_time < 0)
    //    offset = _BendConstraintBufferRW[P_ID].offset0;

    const float offset0 = L0 * sqrt((1 + offset) / 2) * (2.0 / 4);
    const float offset1 = L1 * sqrt((1 + offset) / 2) * (2.0 / 4);

    const float k = _BendConstraintBufferRW[P_ID].stiff == 1.0 ? 1.0 : 1.0 - pow(abs(1 - _BendConstraintBufferRW[P_ID].stiff), 1 / (_itr_count + 1));
    const float3 Vc0 = W0 == 0 || length(p - c0) == 0 ? p * 0 : (2 / W0) * (p - c0) * (1 - offset0 / length(p - c0));
    const float3 Vc1 = W1 == 0 || length(p - c1) == 0 ? p * 0 : (2 / W1) * (p - c1) * (1 - offset1 / length(p - c1));

    if (W > 0)
    {
        AtomicAddDeltaVector(_BendConstraintBufferRW[P_ID].p0, -wv0 * (Vc0 + Vc1) * k * (W0 * W1 / (W * (W0 + W1))));
        AtomicAddDeltaVector(_BendConstraintBufferRW[P_ID].p1, -wv1 * (Vc0 + Vc1) * k * (W0 * W1 / (W * (W0 + W1))));
        AtomicAddDeltaVector(_BendConstraintBufferRW[P_ID].p2, wb0 * Vc0 * k * (W0 / W));
        AtomicAddDeltaVector(_BendConstraintBufferRW[P_ID].p3, wb1 * Vc1 * k * (W1 / W));
    }

}

#pragma kernel PBD_Update_Ass
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void PBD_Update_Ass
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    if (_DeltaCount[P_ID] > 0) {
        float dx = asfloat(_DeltaPosAsInt[P_ID].x);
        float dy = asfloat(_DeltaPosAsInt[P_ID].y);
        float dz = asfloat(_DeltaPosAsInt[P_ID].z);
        _VertBufferRW[P_ID].del = float3(dx, dy, dz) / _DeltaCount[P_ID];
    }
    if (dot(_VertBufferRW[P_ID].ass + _VertBufferRW[P_ID].del - _VertBufferRW[P_ID].pos0, _VertBufferRW[P_ID].nor0) > 0)
        _VertBufferRW[P_ID].ass += _VertBufferRW[P_ID].del;
    _VertBufferRW[P_ID].del = float3(0, 0, 0);
    _DeltaPosAsInt[P_ID] = uint3(0, 0, 0);
}

#pragma kernel PBD_Update_Pos
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void PBD_Update_Pos
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;
    
    _VertBufferRW[P_ID].vel = (_VertBufferRW[P_ID].ass - _VertBufferRW[P_ID].pos);
    _VertBufferRW[P_ID].vel *= abs(_delta_time) > 0 ? 1 / abs(_delta_time) : 0;
    if (abs(_delta_time) > 0)
        _VertBufferRW[P_ID].pos = _VertBufferRW[P_ID].ass;
}

#pragma kernel SearchVertices
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SearchVertices
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    uint home_e = _VertBufferRW[P_ID].edge;
    uint tmp_e = home_e;
    uint count = 0;
    float sum = 0;

    do {
        // 反時計回り: tmp_eは頂点から出る方向
        // 反時計回り処理: すべてのtmp_e

        if (_EdgeBufferRW[tmp_e].stat == 1) {
            // 反時計回処理: ペア存在しないtmp_e
            // モデルの縁に来た

            tmp_e = _EdgeBufferRW[home_e].prev;
            while (_EdgeBufferRW[tmp_e].pair != -1) {
                // 時計回り: tmp_eは頂点に向かう方向
                // 時計回り処理: すべてのtmp_e
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
                sum += _EdgeBufferRW[tmp_e].angle;
                count++;
                if (count > 100) break;
            }
            // 時計回り処理: ペアが存在しないtmp_e
            break;
        }
        // 反時計回り処理: ペアが存在しているtmp_e 

        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
        sum += _EdgeBufferRW[tmp_e].angle;
        count++;

        if (count > 100) break;
    } while (tmp_e != home_e);
    
    float K = - sum / count * 8;

    if (K > 0)
        _VertBufferRW[P_ID].col = float4(0, 0, 1, 1) * (K) + float4(0, 1, 0, 1) * (1 - K);
    else
        _VertBufferRW[P_ID].col = float4(1, 0, 0, 1) * (-K) + float4(0, 1, 0, 1) * (1 + K);
}

#pragma kernel SetVertices
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetVertices
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    _VertexBufferRW[P_ID].pos = _VertBufferRW[P_ID].pos;
    _VertexBufferRW[P_ID].nor = _VertBufferRW[P_ID].nor;
    _VertexBufferRW[P_ID].uv = _VertBufferRW[P_ID].uv;
    _VertexBufferRW[P_ID].col = _VertBufferRW[P_ID].col;
}
#pragma kernel SetVertColor_Normal
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetVertColor_Normal
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) { 
        return;
    }
    float r = min(max(_VertBufferRW[P_ID].rust / 100, 0), 1);
    float g = min(max(1.0 - exp(-_VertBufferRW[P_ID].dust), 0), 1);
    float b = min(max(1.0 - exp(-_VertBufferRW[P_ID].chalk), 0), 1);
    _VertBufferRW[P_ID].col = float4(r, g, b, 1);
    //_VertBufferRW[P_ID].col.x = min(_VertBufferRW[P_ID].rust / 100, 1);
    //_VertBufferRW[P_ID].col.y = 1.0 - exp(-_VertBufferRW[P_ID].dust);
    //_VertBufferRW[P_ID].col.z = 1.0 - exp(-_VertBufferRW[P_ID].chalk);
}
#pragma kernel SetVertColor_Separate
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetVertColor_Separate
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    float val = (_VertBufferRW[P_ID].bond - _VertBufferRW[P_ID].liftingForce);
    val = min(max(val / 100, 0), 1);
    float r = 0;
    float g = 0;
    float b = 0;
    if (val > 0.75)
    {
        r = 0; g = (1 - val) * 4; b = 1;
    }
    else if (val > 0.50)
    {
        r = 0; g = 1; b = (val - 0.5) * 4;
    }
    else if (val > 0.25) 
    {
        r = (0.5 - val) * 4; g = 1; b = 0;
    }
    else {
        r = 1; g = val * 4; b = 0;
    }
    _VertBufferRW[P_ID].col = float4(r, g, b, 1);
}
#pragma kernel SetVertColor_Tear
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetVertColor_Tear
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32)
    {
        _VertBufferRW[P_ID].col = float4(1, 0, 1, 1); return;
    }
    uint home_e = _VertBufferRW[P_ID].edge;
    uint tmp_e = home_e;
    uint count = 0;

    float val = 0;

    // 頂点単位の断裂しやすさ：可視化用のためだけの計算なので、必要なときにしかは計算しない
    do {
        // 反時計回り: tmp_eは頂点から出る方向
        // 反時計回り処理: すべてのtmp_e

        if (_EdgeBufferRW[tmp_e].stat > 0) {
            // 反時計回処理: ペア存在しないtmp_e
            // モデルの縁に来た

            tmp_e = _EdgeBufferRW[home_e].prev;
            while (_EdgeBufferRW[tmp_e].stat == 0) {
                // 時計回り: tmp_eは頂点に向かう方向
                // 時計回り処理: すべてのtmp_e
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
                val += _EdgeBufferRW[tmp_e].bindingForce - _FaceBufferRW[_EdgeBufferRW[tmp_e].face].tension;
                val += _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].bindingForce
                        - _FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].face].tension;
                if (_VertBufferRW[_EdgeBufferRW[tmp_e].vert].stat == 2) {
                    float3 ed = _VertBufferRW[P_ID].pos - _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
                    float rad = length(ed);
                    ed /= rad;
                    float cos = dot(_VertBufferRW[_EdgeBufferRW[tmp_e].vert].direction, ed);
                    float sin = sqrt(1 - cos * cos);
                    float cos1h = sqrt((1 + cos) / 2);
                    float sin1h = sqrt((1 - cos) / 2);
                    float sin3h = 3 * sin1h - 4 * sin1h * sin1h * sin1h;
                    float cos3h = 4 * cos1h * cos1h * cos1h - 3 * cos1h;
                    float sx = cos1h * (1 - sin1h * sin3h);
                    float sy = cos1h * (1 + sin1h * sin3h);
                    float sxy = cos1h * sin1h * cos3h;
                    sx /= sqrt(rad);
                    sy /= sqrt(rad);
                    sxy /= sqrt(rad);
                    float s = sy * cos * cos + sx * sin * sin - 2 * sxy * cos * sin;
                    val -= s * 200;
                }
                count++;
            }
            // 時計回り処理: ペアが存在しないtmp_e
            break;
        }
        // 反時計回り処理: ペアが存在しているtmp_e 
        val += _EdgeBufferRW[tmp_e].bindingForce - _FaceBufferRW[_EdgeBufferRW[tmp_e].face].tension;
        val += _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].bindingForce
                - _FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].face].tension;

        if (_VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].vert].stat == 2) {
            float3 ed = _VertBufferRW[P_ID].pos - _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].vert].pos;
            float rad = length(ed);
            ed /= rad;
            float cos = dot(_VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].vert].direction, ed);
            float sin = sqrt(1 - cos * cos);
            float cos1h = sqrt((1 + cos) / 2);
            float sin1h = sqrt((1 - cos) / 2);
            float sin3h = 3 * sin1h - 4 * sin1h * sin1h * sin1h;
            float cos3h = 4 * cos1h * cos1h * cos1h - 3 * cos1h;
            float sx = cos1h * (1 - sin1h * sin3h);
            float sy = cos1h * (1 + sin1h * sin3h);
            float sxy = cos1h * sin1h * cos3h;
            sx /= sqrt(rad);
            sy /= sqrt(rad);
            sxy /= sqrt(rad);
            float s = sy * cos * cos + sx * sin * sin - 2 * sxy * cos * sin;
            val -= s * 200;
        }
        count++;

        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
    } while (tmp_e != home_e);
    //if (tmp_e == home_e) count--;

    //val = log(1 + (val / count) / 10) * 1;
    val *= 0.0004 / count;
    val = min(max(val, 0), 1);
    float r = 0;
    float g = 0;
    float b = 0;
    if (val > 0.75)
    {
        r = 0; g = (1 - val) * 4; b = 1;
    }
    else if (val > 0.50)
    {
        r = 0; g = 1; b = (val - 0.5) * 4;
    }
    else if (val > 0.25)
    {
        r = (0.5 - val) * 4; g = 1; b = 0;
    }
    else {
        r = 1; g = val * 4; b = 0;
    }
    _VertBufferRW[P_ID].col = float4(r, g, b, 1);

    //return;
    // デバッグ用のカラー設定
    if (_VertBufferRW[P_ID].stat == 0) {
        r = 1;
        g = 1;
        b = 1;
    } else if (_VertBufferRW[P_ID].stat == 1) {
        r = 0.5;
        g = 0.5;
        b = 0.5;
    }
    else if (_VertBufferRW[P_ID].stat == 2) {
        r = 1;
        g = 0;
        b = 0;
    }
    else if (_VertBufferRW[P_ID].stat== 3) {
        r = 1;
        g = 1;
        b = 0;
    }
    else if (_VertBufferRW[P_ID].stat == 4) {
        r = 0;
        g = 1;
        b = 0;
    }
    else if (_VertBufferRW[P_ID].stat == 5) {
        r = 0;
        g = 1;
        b = 1;
    }
    else if (_VertBufferRW[P_ID].stat == 6) {
        r = 0;
        g = 0;
        b = 1;
    }
    else if (_VertBufferRW[P_ID].stat == 32) {
        r = 0;
        g = 0;
        b = 0;
    }
    else if (_VertBufferRW[P_ID].stat == 64) {
        r = 1;
        g = 0;
        b = 1;
    }
    else if (_VertBufferRW[P_ID].stat > 2) {
        r = 0;
        g = 0;
        b = 0;
    }

    _VertBufferRW[P_ID].col = float4(r, g, b, 1);
}
#pragma kernel SetTriangles
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetTriangles
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _FaceNum) return;

    if (_FaceBufferRW[P_ID].stat == 1) // インデックスをずらすのは不都合なので面積0の三角形を作っておく
    {
        _TriangleBufferRW[P_ID * 3] = 0;
        _TriangleBufferRW[P_ID * 3 + 1] = 0;
        _TriangleBufferRW[P_ID * 3 + 2] = 0;
        return;
    }

    Edge tmp = _EdgeBufferRW[_FaceBufferRW[P_ID].edge];
    _TriangleBufferRW[P_ID * 3   ] = tmp.vert;
    tmp = _EdgeBufferRW[tmp.next];
    _TriangleBufferRW[P_ID * 3 + 1] = tmp.vert;
    tmp = _EdgeBufferRW[tmp.next];
    _TriangleBufferRW[P_ID * 3 + 2] = tmp.vert;
}
#pragma kernel SetFaceNormals
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetFaceNormals
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _FaceNum) return;
    uint vi = _EdgeBufferRW[_FaceBufferRW[P_ID].edge].vert;
    uint vn = _EdgeBufferRW[_EdgeBufferRW[_FaceBufferRW[P_ID].edge].next].vert;
    uint vp = _EdgeBufferRW[_EdgeBufferRW[_FaceBufferRW[P_ID].edge].prev].vert;
    _FaceBufferRW[P_ID].nor = normalize(cross(_VertBufferRW[vn].pos - _VertBufferRW[vi].pos, _VertBufferRW[vp].pos - _VertBufferRW[vn].pos));
}
#pragma kernel SetVertNormals
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetVertNormals
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    uint home_e = _VertBufferRW[P_ID].edge;
    uint tmp_e = home_e;
    uint count = 0;
    float3 sum = 0;

    do {
        // 反時計回り: tmp_eは頂点から出る方向
        // 反時計回り処理: すべてのtmp_e

        if (_EdgeBufferRW[tmp_e].stat != 0) {
            // 反時計回処理: ペア存在しないtmp_e
            // モデルの縁に来た
            tmp_e = _EdgeBufferRW[home_e].prev;
            sum += _FaceBufferRW[_EdgeBufferRW[tmp_e].face].nor; // home_e.face.nor
            while (_EdgeBufferRW[tmp_e].stat == 0) {
                // 時計回り: tmp_eは頂点に向かう方向
                // 時計回り処理: すべてのtmp_e
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
                sum += _FaceBufferRW[_EdgeBufferRW[tmp_e].face].nor;
            }
            // 時計回り処理: ペアが存在しないtmp_e
            break;
        }
        // 反時計回り処理: ペアが存在しているtmp_e 

        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
        sum += _FaceBufferRW[_EdgeBufferRW[tmp_e].face].nor;
    } while (tmp_e != home_e);

    _VertBufferRW[P_ID].nor = normalize(sum);
}
#pragma kernel SetVertForces
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetVertForces
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    _VertBufferRW[P_ID].liftingForce = 0;
    _LiftingForceCount[P_ID] = 0;
    _LiftingForceAsInt[P_ID] = 0;
}
#pragma kernel UpdateLiftingForce
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void UpdateLiftingForce
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;

    float lifting_force_ratio = 0.1;

    if (P_ID >= _EdgeNum) return;

    Edge hei = _EdgeBufferRW[P_ID];
    
    _EdgeBufferRW[P_ID].liftingForce = 1.0 * lifting_force_ratio * _FaceBufferRW[hei.face].contraction / (1 + exp(- 4 * hei.angle));
    
    // Edgeの探索からVert.liftingForceにアクセスするにはAtomic演算が必要になるので
    // UpdateVertForcesからVertの周りをぐるっと探索する方式に変更した
    //AtomicAddLiftingForce(_EdgeBufferRW[_EdgeBufferRW[P_ID].prev].vert, _EdgeBufferRW[P_ID].liftingForce);

    if (_BendConstraintBufferRW[P_ID].thr >= 0) {
        //_BendConstraintBufferRW[P_ID].offset += (0.3 - _BendConstraintBufferRW[P_ID].offset) * 0.005f * hei.liftingForce * _delta_time;
    }
}
#pragma kernel UpdateVertForces
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void UpdateVertForces
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    _VertBufferRW[P_ID].liftingForce = asfloat(_LiftingForceAsInt[P_ID]);
    
    //_VertBufferRW[P_ID].bond -= (1 - exp(- _VertBufferRW[P_ID].chalk));

    // 対話的操作 (比較対象は初期位置とする)
    if ((_control_separation > 0 || _control_stain > 0)
        && length(_VertBufferRW[P_ID].pos0 - _hit_point.xyz) < _hit_point.w) {
        if (_control_separation == 1) {
            _VertBufferRW[P_ID].bond -= _VertBufferRW[P_ID].bond * 0.05;
        }
        if (_control_separation > 1) {
            _VertBufferRW[P_ID].bond += (_VertBufferRW[P_ID].liftingForce + 200 - _VertBufferRW[P_ID].bond) * 0.05;
            if (_control_separation == 3) {
                ReattachVertex(P_ID);
                ControlStain(P_ID);
            }
        }
        if (_control_stain > 0)
            ControlStain(P_ID);
    }
    
    int home_e = _VertBufferRW[P_ID].edge;
    int tmp_e = home_e;
    uint count = 0;
    _VertBufferRW[P_ID].liftingForce = 0;

    do {
        // 反時計回り: tmp_eは頂点から出る方向
        // 反時計回り処理: すべてのtmp_e
        _VertBufferRW[P_ID].liftingForce += _EdgeBufferRW[_EdgeBufferRW[tmp_e].next].liftingForce;

        if (_EdgeBufferRW[tmp_e].stat > 0) {
            // 反時計回処理: ペア存在しないtmp_e
            // モデルの縁に来た
            tmp_e = _EdgeBufferRW[home_e].prev;
            while (_EdgeBufferRW[tmp_e].stat == 0) {
                // 時計回り: tmp_eは頂点に向かう方向
                // 時計回り処理: すべてのtmp_e
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
                _VertBufferRW[P_ID].liftingForce += _EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].liftingForce;
                count++;
                if (count > 100) break;
            }
            // 時計回り処理: ペアが存在しないtmp_e
            break;
        }
        // 反時計回り処理: ペアが存在しているtmp_e 

        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
        count++;

        if (count > 100) break;
    } while (tmp_e != home_e);

    //float v = _VertBufferRW[P_ID].liftingForce / 64;
    //if (v < 0.5)
    //    _VertBufferRW[P_ID].col = float4(0, 0, 1 - v * 2, 1);
    //else
    //    _VertBufferRW[P_ID].col = float4((v - 0.5) * 2, 0, 0, 1);
}
#pragma kernel UpdateBindingForce
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void UpdateBindingForce
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _FaceNum) return;

    // tearの処理で_VertCounter[1]が減り過ぎている可能性がある
    // 最初に到達したスレッドでしか意味のない処理 (他は自然と動く) なので
    if (_VertCounter[1] > _VertCounter[0]) _VertCounter[1] = 0;

    float damage = 10.0 * _delta_time;
    float damage2 = 2.0 * _delta_time;

    int ei = _FaceBufferRW[P_ID].edge;
    int ep = _EdgeBufferRW[ei].prev;
    int en = _EdgeBufferRW[ei].next;
    float3 mi = (_VertBufferRW[_EdgeBufferRW[ei].vert].pos0 + _VertBufferRW[_EdgeBufferRW[en].vert].pos0) / 2;
    float3 mp = (_VertBufferRW[_EdgeBufferRW[ep].vert].pos0 + _VertBufferRW[_EdgeBufferRW[ei].vert].pos0) / 2;
    float3 mn = (_VertBufferRW[_EdgeBufferRW[en].vert].pos0 + _VertBufferRW[_EdgeBufferRW[ep].vert].pos0) / 2;
    mi = _VertBufferRW[_EdgeBufferRW[ei].vert].pos0;
    mp = _VertBufferRW[_EdgeBufferRW[ep].vert].pos0;
    mn = _VertBufferRW[_EdgeBufferRW[en].vert].pos0;

    float r = 0.05;
    float maxval = 2000;
    // 対話的操作
    if (_control_tear == 1 && length(mi - _hit_point.xyz) < _hit_point.w)
        _EdgeBufferRW[ei].bindingForce -= _EdgeBufferRW[ei].bindingForce * r;
    if (_control_tear > 1 && length(mi - _hit_point.xyz) < _hit_point.w)
    {
        _EdgeBufferRW[ei].bindingForce += (maxval - _EdgeBufferRW[ei].bindingForce) * r;
        if (_control_tear == 3 && _FaceBufferRW[P_ID].stat == 0)
            ReconnectEdges(ei);
    }
    if (_control_tear == 1 && length(mp - _hit_point.xyz) < _hit_point.w)
        _EdgeBufferRW[ep].bindingForce -= _EdgeBufferRW[ep].bindingForce * r;
    if (_control_tear > 1 && length(mp - _hit_point.xyz) < _hit_point.w)
    {
        _EdgeBufferRW[ep].bindingForce += (maxval - _EdgeBufferRW[ep].bindingForce) * r;
        if (_control_tear == 3 && _FaceBufferRW[P_ID].stat == 0)
            ReconnectEdges(ep);
    }
    if (_control_tear == 1 && length(mn - _hit_point.xyz) < _hit_point.w)
        _EdgeBufferRW[en].bindingForce -= _EdgeBufferRW[en].bindingForce * r;
    if (_control_tear > 1 && length(mn - _hit_point.xyz) < _hit_point.w)
    {
        _EdgeBufferRW[en].bindingForce += (maxval - _EdgeBufferRW[en].bindingForce) * r;
        if (_control_tear == 3 && _FaceBufferRW[P_ID].stat == 0)
            ReconnectEdges(en);
    }
    
    if (_EdgeBufferRW[ei].stat == 0) {
        if (_EdgeBufferRW[ep].stat == 0) {
            if (_EdgeBufferRW[en].stat == 0) {
                // 3
            }
            else {
                // 2 (i & prev)
                _EdgeBufferRW[ei].bindingForce += -damage2;
                _EdgeBufferRW[ep].bindingForce += -damage2;
            }
        }
        else {
            if (_EdgeBufferRW[en].stat == 0) {
                // 2 (i & next)
                _EdgeBufferRW[ei].bindingForce += -damage2;
                _EdgeBufferRW[en].bindingForce += -damage2;
            }
            else {
                // 1 (i)
                _EdgeBufferRW[ei].bindingForce += -damage;
            }
        }
    }
    else {
        if (_EdgeBufferRW[ep].stat == 0) {
            if (_EdgeBufferRW[en].stat == 0) {
                // 2 (prev & next)
                _EdgeBufferRW[ep].bindingForce += -damage2;
                _EdgeBufferRW[en].bindingForce += -damage2;
            }
            else {
                // 1 (prev)
                _EdgeBufferRW[ep].bindingForce += -damage;
            }
        }
        else {
            if (_EdgeBufferRW[en].stat == 0) {
                // 1 (next)
                _EdgeBufferRW[en].bindingForce += -damage;
            }
            else {
                // 0 (i)
            }
        }
    }
    _FaceBufferRW[P_ID].contraction += 0.5 * _delta_time;
    if (_FaceBufferRW[P_ID].contraction < 0) _FaceBufferRW[P_ID].contraction = 0;

    _LengthConstraintBufferRW[ei].offset = _LengthConstraintBufferRW[ei].offset0 * (1.0 - _FaceBufferRW[_EdgeBufferRW[P_ID].face].contraction * 0.0001); //- _FaceBufferRW[P_ID].contraction / k2; //
    _LengthConstraintBufferRW[en].offset = _LengthConstraintBufferRW[en].offset0 * (1.0 - _FaceBufferRW[_EdgeBufferRW[P_ID].face].contraction * 0.0001); //- _FaceBufferRW[P_ID].contraction / k2; //
    _LengthConstraintBufferRW[ep].offset = _LengthConstraintBufferRW[ep].offset0 * (1.0 - _FaceBufferRW[_EdgeBufferRW[P_ID].face].contraction * 0.0001); //- _FaceBufferRW[P_ID].contraction / k2;

    _BendConstraintBufferRW[ei].offset = _BendConstraintBufferRW[ei].offset0 + (_delta_time < 0 ? 0: 0.4);//min(_FaceBufferRW[P_ID].contraction / k2 * 100, 0.4);
    _BendConstraintBufferRW[en].offset = _BendConstraintBufferRW[en].offset0 + (_delta_time < 0 ? 0 : 0.4);//min(_FaceBufferRW[P_ID].contraction / k2 * 100, 0.4);
    _BendConstraintBufferRW[ep].offset = _BendConstraintBufferRW[ep].offset0 + (_delta_time < 0 ? 0 : 0.4);//min(_FaceBufferRW[P_ID].contraction / k2 * 100, 0.4);

    _FaceBufferRW[P_ID].tension = _FaceBufferRW[P_ID].contraction;

    float3 vi = _VertBufferRW[_EdgeBufferRW[ei].vert].pos;
    float3 vp = _VertBufferRW[_EdgeBufferRW[ep].vert].pos;
    float3 vn = _VertBufferRW[_EdgeBufferRW[en].vert].pos;
    //_FaceBufferRW[P_ID].tension = _FaceBufferRW[P_ID].contraction 
    //                            + k1 * (length(vi - vn) - _LengthConstraintBufferRW[ei].offset
    //                                    + length(vn - vp) - _LengthConstraintBufferRW[en].offset
    //                                    + length(vp - vi) - _LengthConstraintBufferRW[en].offset
    //                                );
}

#pragma kernel SeparateVertex
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SeparateVertex
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    Vert vi = _VertBufferRW[P_ID];

    //uint val = 1;
    //InterlockedCompareExchange(_VertBufferRW[11].stat, 1, 100, val);
    //if (val == 1)
    //    _VertBufferRW[11].stat += 1;

    //_VertBufferRW[P_ID].col = float4(0, 0, (vi.bond - vi.liftingForce) / 100, 1);
    //_VertBufferRW[P_ID].col = float4(1, 1, 1, 1);
    //if (vi.stat == 1) _VertBufferRW[P_ID].col = float4(1, 1, 0, 1);
    //if (vi.stat == 2) _VertBufferRW[P_ID].col = float4(1, 0, 0, 1);
    //if (vi.stat == 3) _VertBufferRW[P_ID].col = float4(0, 1, 0, 1);
    //if (vi.stat > 3) _VertBufferRW[P_ID].col = float4(0, 0, 1, 1);
    //_VertBufferRW[P_ID].col = float4(1, 1, 1, 0) * exp(-_VertBufferRW[P_ID].dust) + float4(0, 0, 0, 1);

    _VertBufferRW[P_ID].bond += -0.25 * _delta_time;
    if (_VertBufferRW[P_ID].bond < 0) _VertBufferRW[P_ID].bond = 0;

    if (vi.stat > 0) {
        // 接着処理
        // 逆再生でなければ実行しない
        if (_delta_time > 0) return;
        // 条件1：付着力が揚力を上回る
        if (vi.bond < vi.liftingForce)  return;
        // 条件2：元の位置に十分近い
        if (length(vi.pos - vi.pos0) > 0.01)  return;
        int home_e = vi.edge;
        int tmp_e = home_e;
        uint count = 0;

        // 条件3：断裂した稜線に接続されていない
        do {
            // 反時計回り
            if (_EdgeBufferRW[tmp_e].stat > 1)
                return;
            if (_EdgeBufferRW[tmp_e].stat == 1) {
                // モデルの縁に来たら時計回り
                tmp_e = _EdgeBufferRW[home_e].prev;

                while (_EdgeBufferRW[tmp_e].stat != 1) {
                    if (_EdgeBufferRW[tmp_e].stat > 1)
                        return;
                    tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
                }
                _LengthConstraintBufferRW[tmp_e].thr = 0.001; // ペアがなくても長さ制約ON 
                break;
            }
            tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
        } while (tmp_e != home_e);
        
        // 接着
        _VertBufferRW[P_ID].stat = 0;
        _VertBufferRW[P_ID].w = 0.0;
        _VertBufferRW[P_ID].pos = _VertBufferRW[P_ID].pos0;

        // 
    }
    else {
        if (vi.bond > vi.liftingForce)  return;
        if (_delta_time < 0) return;

        // 分離処理
        _VertBufferRW[P_ID].stat = 1;

        //if (_VertBufferRW[P_ID].onEdge == 0)
        _VertBufferRW[P_ID].w = 1.0;

        int home_e = vi.edge;
        int tmp_e = home_e;
        uint count = 0;

        do {
            // 反時計回り
            if (_EdgeBufferRW[tmp_e].stat == 1) {
                _LengthConstraintBufferRW[tmp_e].thr = 0.001; // モデルの縁でも長さ制約はON，ただし断裂まで片方だけに設定
                // モデルの縁に来たら時計回り
                tmp_e = _EdgeBufferRW[home_e].prev;

                while (_EdgeBufferRW[tmp_e].stat != 1) {
                    tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
                    if (_LengthConstraintBufferRW[_EdgeBufferRW[tmp_e].pair].thr < 0)
                        _LengthConstraintBufferRW[tmp_e].thr = 0.001; // 長さ制約ON
                    if (_BendConstraintBufferRW[_EdgeBufferRW[tmp_e].pair].thr < 0)
                        _BendConstraintBufferRW[tmp_e].thr = 0.001; // ペアが存在している場合に曲げ制約ON
                }
                _LengthConstraintBufferRW[tmp_e].thr = 0.001; // ペアがなくても長さ制約ON 
                break;
            }
            if (_LengthConstraintBufferRW[_EdgeBufferRW[tmp_e].pair].thr < 0)
                _LengthConstraintBufferRW[tmp_e].thr = 0.001; // モデルの縁でも長さ制約はON，ただし断裂まで片方だけに設定
            if (_BendConstraintBufferRW[_EdgeBufferRW[tmp_e].pair].thr < 0)
                _BendConstraintBufferRW[tmp_e].thr = 0.001; // ペアが存在している場合に曲げ制約ON，こちらも片方だけ

            tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
        } while (tmp_e != home_e);
    }
}

#pragma kernel TearEdge
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void TearEdge
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;

    float lifting_force_ratio = 0.1;

    if (P_ID >= _EdgeNum) return;
    if (_EdgeBufferRW[P_ID].stat == 1) return;
    if ((int)P_ID > _EdgeBufferRW[P_ID].pair) return;     // 片方のエッジだけの処理

    Edge ei = _EdgeBufferRW[P_ID];
    Edge ep = _EdgeBufferRW[ei.pair];
    Face fi = _FaceBufferRW[ei.face];
    Face fp = _FaceBufferRW[ep.face];

    float fit = fi.tension;
    float fpt = fp.tension;
    float eib = ei.bindingForce;
    float epb = ep.bindingForce;
    bool crack = false;

    float direct_thr = 0.75;
    float bind_ratio = 0.2;
    float rp = 2.0;         // 張力緩和の係数

    float tear_force = fit / (1 + exp(-2 * ei.angle)) + fpt / (1 + exp(-2 * ep.angle));
    float bind_force = (eib + epb) / 2;

    uint v;

    if (_EdgeBufferRW[P_ID].stat == 0) {
        if (_delta_time < 0) return;
        // 断裂処理
        if (tear_force > bind_force) {
            //_VertBufferRW[ep.vert].col = float4(0, 0, 1, 1);
            // 通常条件
            crack = true;
        }
        // 簡易バージョン
        /*
        else if (_VertBufferRW[ei.vert].stat == 2 && false) {
            // 特殊条件 亀裂の端点だった場合，割れやすくなる
            float3 ed = normalize(_VertBufferRW[ep.vert].pos - _VertBufferRW[ei.vert].pos);
            float d = dot(_VertBufferRW[ei.vert].direction, ed);
            if (d > direct_thr && tear_force > bind_force * bind_ratio)
                crack = true;
        }
        else if (_VertBufferRW[ep.vert].stat == 2 && false) {
            // 特殊条件 亀裂の端点だった場合，割れやすくなる
            float3 ed = normalize(_VertBufferRW[ei.vert].pos - _VertBufferRW[ep.vert].pos);
            float d = dot(_VertBufferRW[ep.vert].direction, ed);
            if (d > direct_thr && tear_force > bind_force * bind_ratio)
                crack = true;
        }*/
        // 応力集中バージョン
        else if (_VertBufferRW[ei.vert].stat == 2 && true) {
            // 特殊条件 亀裂の端点だった場合，割れやすくなる
            float3 ed = _VertBufferRW[ep.vert].pos - _VertBufferRW[ei.vert].pos;
            float rad = length(ed);
            ed /= rad;
            float cos = dot(_VertBufferRW[ei.vert].direction, ed);
            float sin = sqrt(1 - cos * cos);
            float cos1h = sqrt((1 + cos) / 2);
            float sin1h = sqrt((1 - cos) / 2);
            float sin3h = 3 * sin1h - 4 * sin1h * sin1h * sin1h;
            float cos3h = 4 * cos1h * cos1h * cos1h - 3 * cos1h;
            float sx = cos1h * (1 - sin1h * sin3h);
            float sy = cos1h * (1 + sin1h * sin3h);
            float sxy = cos1h * sin1h * cos3h;
            sx /= sqrt(rad);
            sy /= sqrt(rad);
            sxy /= sqrt(rad);
            float s = sy * cos * cos + sx * sin * sin - 2 * sxy * cos * sin;
            if (tear_force * s * 1 > bind_force)
                crack = true;
        }
        else if (_VertBufferRW[ep.vert].stat == 2 && true) {
            // 特殊条件 亀裂の端点だった場合，割れやすくなる
            float3 ed = _VertBufferRW[ei.vert].pos - _VertBufferRW[ep.vert].pos;
            float rad = length(ed);
            ed /= rad;
            float cos = dot(_VertBufferRW[ep.vert].direction, ed);
            float sin = sqrt(1 - cos * cos);
            float cos1h = sqrt((1 + cos) / 2);
            float sin1h = sqrt((1 - cos) / 2);
            float sin3h = 3 * sin1h - 4 * sin1h * sin1h * sin1h;
            float cos3h = 4 * cos1h * cos1h * cos1h - 3 * cos1h;
            float sx = cos1h * (1 - sin1h * sin3h);
            float sy = cos1h * (1 + sin1h * sin3h);
            float sxy = cos1h * sin1h * cos3h;
            sx /= sqrt(rad);
            sy /= sqrt(rad);
            sxy /= sqrt(rad);
            float s = sy * cos * cos + sx * sin * sin - 2 * sxy * cos * sin;
            if (tear_force * s * 1 > bind_force)
                crack = true;
        }
        // そもそも亀裂が発生する状態なのかのチェック
        if (_VertBufferRW[ei.vert].stat == 0)
            crack = false;
        if (_VertBufferRW[ep.vert].stat == 0)
            crack = false;
        if (_EdgeBufferRW[_EdgeBufferRW[P_ID].pair].stat > 1)
            crack = false;
        // 2倍以上伸びた稜線を強制的に断裂
        if (!crack) {
            uint v0 = _EdgeBufferRW[P_ID].vert;
            uint v1 = _EdgeBufferRW[_EdgeBufferRW[P_ID].next].vert;
            uint v2 = _EdgeBufferRW[_EdgeBufferRW[P_ID].prev].vert;
            if (length(_VertBufferRW[v0].pos - _VertBufferRW[v1].pos)
            > length(_VertBufferRW[v0].pos0 - _VertBufferRW[v1].pos0) * 2
                ||
                length(_VertBufferRW[v1].pos - _VertBufferRW[v2].pos)
            > length(_VertBufferRW[v1].pos0 - _VertBufferRW[v2].pos0) * 2
                ||
                length(_VertBufferRW[v2].pos - _VertBufferRW[v0].pos)
            > length(_VertBufferRW[v2].pos0 - _VertBufferRW[v0].pos0) * 2
                )
                crack = true;
        }
        if (!crack) return;

        uint val3 = 3;
        InterlockedCompareExchange(_LockProcess[_VertBufferRW[ei.vert].orig], 0, 1, val3);
        if (val3 != 0)
            return;
        val3 = 3;
        InterlockedCompareExchange(_LockProcess[_VertBufferRW[ep.vert].orig], 0, 1, val3);
        if (val3 != 0)
            return;

        // アトミックでstatを加算: statを指定する処理もアトミックになる
        uint val1 = 1;
        uint val2 = 2;
        // 亀裂連結稜線 (両端にもう亀裂がある稜線) の場合
        if (_VertBufferRW[ei.vert].stat > 1 && _VertBufferRW[ep.vert].stat > 1) {
            _EdgeBufferRW[P_ID].stat = 3;
            _EdgeBufferRW[ei.pair].stat = 3;
        }
        else {
            _EdgeBufferRW[P_ID].stat = 2;
            _EdgeBufferRW[ei.pair].stat = 2;
        }
        //InterlockedCompareExchange(_EdgeBufferRW[P_ID].stat, 0, 2, val1);
        //if (val1 != 0)
        //    return;
        //InterlockedCompareExchange(_EdgeBufferRW[ei.pair].stat, 0, 2, val2);
        //if (val2 != 0)
        //    return;
        // たまたま同じタイミングで1個目のInterlockedCompareExchangeが実行された場合，
        // 2つのスレッド val1, val2の片方ずつ (おそらくどっちもval1の方) だけが0になる
        // その場合はedgeのIDが小さい方にその後の処理を任せる
        //if ((val1 == 0 || val2 == 0) && (val1 != 0 || val2 != 0))
        //if (val1 == 0 && val2 != 0)
        //    if (P_ID > ei.pair)                                     
        //        return;

        //_EdgeBufferRW[ei.pair].stat = 1;
        InterlockedAdd(_VertBufferRW[ei.vert].stat, 1);
        InterlockedAdd(_VertBufferRW[ep.vert].stat, 1);

        // 新たに亀裂の端点になった場合
        if (_VertBufferRW[ei.vert].stat == 2) {
            float3 d = normalize(_VertBufferRW[ei.vert].pos - _VertBufferRW[ep.vert].pos);
            d += _VertBufferRW[ep.vert].direction; // 前の方向を参照
            _VertBufferRW[ei.vert].direction = normalize(d);
            if (dot(_VertBufferRW[ei.vert].direction, _gravity.xyz) > 0)
            {
                _VertBufferRW[ei.vert].lowest = true;
                //_VertBufferRW[ei.vert].rust += 100;
            }
        }
        if (_VertBufferRW[ep.vert].stat == 2) {
            float3 d = normalize(_VertBufferRW[ep.vert].pos - _VertBufferRW[ei.vert].pos);
            d += _VertBufferRW[ei.vert].direction; // 前の方向を参照
            _VertBufferRW[ep.vert].direction = normalize(d);
            if (dot(_VertBufferRW[ep.vert].direction, _gravity.xyz) > 0)
            {
                _VertBufferRW[ep.vert].lowest = true;
                //_VertBufferRW[ep.vert].rust += 100;
            }
        }

        // 曲げ制約無効化
        _BendConstraintBufferRW[P_ID].thr = -1;
        _BendConstraintBufferRW[ei.pair].thr = -1;
        // 長さ制約有効化 (断裂前は片方だけ有効になっている)
        _LengthConstraintBufferRW[P_ID].thr = 0.001;
        _LengthConstraintBufferRW[ei.pair].thr = 0.001;

        // 張力緩和
        //_FaceBufferRW[ei.face].contraction *= rp;
        //if (_EdgeBufferRW[ei.next].pair != -1)  _FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[ei.next].pair].face].contraction *= rp;
        //if (_EdgeBufferRW[ei.prev].pair != -1)  _FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[ei.prev].pair].face].contraction *= rp;
        //if (ei.pair != -1)  _FaceBufferRW[_EdgeBufferRW[ei.pair].face].contraction *= rp;
        //_FaceBufferRW[ei.face].contraction *= rp;

        //_FaceBufferRW[ep.face].contraction *= rp;
        //if (_EdgeBufferRW[ep.next].pair != -1)  _FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[ep.next].pair].face].contraction *= rp;
        //if (_EdgeBufferRW[ep.prev].pair != -1)  _FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[ep.prev].pair].face].contraction *= rp;
        //if (ep.pair != -1)  _FaceBufferRW[_EdgeBufferRW[ep.pair].face].contraction *= rp;
        //_FaceBufferRW[ei.face].contraction *= rp;

        if (_VertBufferRW[ei.vert].stat > 2 && _VertBufferRW[ei.vert].onEdge == 0) // ei.vertから見てこれが二本目以上の断裂，頂点を分割する
        {
            if (_VertBufferRW[ei.vert].lowest && dot(_gravity.xyz, _VertBufferRW[ep.vert].pos - _VertBufferRW[ei.vert].pos) > 0)
                _VertBufferRW[ei.vert].lowest = false;

            // 頂点を有効化
            uint nvi; // new vert index
            uint val = 0;
            InterlockedAdd(_VertCounter[1], -1, val);
            if (val > 0 && val < _VertCounter[0])
            {
                // 正の場合 _BlankIndexの(val - 1)番目から値をとってくる
                nvi = _BlankIndex[val - 1];
                //InterlockedAdd(_VertCounter[0], 1, nvi);
            }
            else {
                // 非正の場合，uint型なので0から減らしているとかなり大きな数になっている
                // 新たに頂点用のIDを発行する
                InterlockedAdd(_VertCounter[0], 1, nvi);// 現在のカウンタの値を新たな頂点のIDとしてから1を加算する
            }
            CloneVert(ei.vert, nvi);                // InterlockerAddの第3引数には加算前の値が格納されることに注意
            InterlockedAdd(_LockProcess[_VertBufferRW[nvi].orig], 1);   // このフレームではこのスレッド以外で頂点の操作を許さない

            int home_e;
            int tore_e;                             // すでに断裂していた稜線
            int tmp_e;
            float3 dR = float3(0, 0, 0);            // 右側方向
            float3 dL = float3(0, 0, 0);            // 左側方向
            int groupR[16];
            int countR = 0;
            int groupL[16];
            int countL = 0;

            // ei.vert周り
            home_e = P_ID;
            tmp_e = home_e;
            // 反時計回り探索 groupRは断裂した稜線を含む
            do {
                if (_EdgeBufferRW[tmp_e].stat == 1) {
                    dR *= 0;
                    countR = 0;
                    break;
                }
                dR += _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos - _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
                if (tmp_e != home_e) {
                    groupR[countR++] = tmp_e;
                }

                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
            } while (_EdgeBufferRW[tmp_e].stat == 0);
            tore_e = tmp_e;
            if (_EdgeBufferRW[tore_e].pair != -1) {
                groupR[countR++] = tore_e;
                dR += _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos - _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
            }

            // 時計回り探索 さっき断裂した半稜線は含むが，断裂していた半稜線は含まない
            groupL[countL++] = home_e;
            tmp_e = _EdgeBufferRW[home_e].prev;

            while (_EdgeBufferRW[tmp_e].stat == 0) {
                if (_EdgeBufferRW[tmp_e].stat == 1) {
                    dL *= 0;
                    countL = 0;
                    break;
                }
                tmp_e = _EdgeBufferRW[tmp_e].pair;
                dL += _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos - _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
                groupL[countL++] = tmp_e;
                tmp_e = _EdgeBufferRW[tmp_e].prev;
            }
            dR = normalize(dR);
            dL = normalize(dL);

            if (countR == 0) {
                // edge.vertの付け替え
                _VertBufferRW[nvi].edge = groupL[0];
                for (int i = 0; i < countL; i++) {
                    SwapVertL(groupL[i], _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupL[i]].next, _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupL[i]].prev, _EdgeBufferRW[groupL[i]].vert, nvi);

                    SwapVertB(groupL[i], _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupL[i]].next, _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupL[i]].prev, _EdgeBufferRW[groupL[i]].vert, nvi);
                    _EdgeBufferRW[groupL[i]].vert = nvi;
                }

                if (dot(_gravity.xyz, dL) > 0) {
                    _VertBufferRW[nvi].rust += 100;// *dot(_gravity.xyz, dL);
                    if (_VertBufferRW[ei.vert].lowest) {
                        _VertBufferRW[ei.vert].lowest = false;
                        _VertBufferRW[nvi].lowest = true;
                    }
                }
                else {
                    _VertBufferRW[nvi].rust = _VertBufferRW[ei.vert].rust;
                    _VertBufferRW[ei.vert].rust += 100;// * dot(_gravity.xyz, -dL);
                    if (_VertBufferRW[ei.vert].lowest) {
                        _VertBufferRW[ei.vert].lowest = true;
                        _VertBufferRW[nvi].lowest = false;
                    }
                }
            }
            else {
                _VertBufferRW[nvi].edge = groupR[0];
                for (int i = 0; i < countR; i++) {
                    SwapVertL(groupR[i], _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupR[i]].next, _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupR[i]].prev, _EdgeBufferRW[groupR[i]].vert, nvi);

                    SwapVertB(groupR[i], _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupR[i]].next, _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupR[i]].prev, _EdgeBufferRW[groupR[i]].vert, nvi);
                    _EdgeBufferRW[groupR[i]].vert = nvi;
                }
                if (dot(_gravity.xyz, dR) > 0) {
                    _VertBufferRW[nvi].rust += 100;// * dot(_gravity.xyz, dR);
                    if (_VertBufferRW[ei.vert].lowest) {
                        _VertBufferRW[ei.vert].lowest = false;
                        _VertBufferRW[nvi].lowest = true;
                    }
                }
                else {
                    _VertBufferRW[nvi].rust = _VertBufferRW[ei.vert].rust;
                    _VertBufferRW[ei.vert].rust += 100;// * dot(_gravity.xyz, -dR);
                    if (_VertBufferRW[ei.vert].lowest) {
                        _VertBufferRW[ei.vert].lowest = true;
                        _VertBufferRW[nvi].lowest = false;
                    }
                }
            }
        } // ei.vertの頂点分割処理

        if (_VertBufferRW[ep.vert].stat > 2 && _VertBufferRW[ep.vert].onEdge == 0) // ei.vertから見てこれが二本目以上の断裂，頂点を分割する
        {
            if (_VertBufferRW[ep.vert].lowest && dot(_gravity.xyz, _VertBufferRW[ep.vert].pos - _VertBufferRW[ep.vert].pos) > 0)
                _VertBufferRW[ep.vert].lowest = false;

            // 頂点を有効化
            uint nvi; // new vert index
            uint val = 0;
            InterlockedAdd(_VertCounter[1], -1, val);
            if (val > 0 && val < _VertCounter[0])
            {
                // 正の場合 _BlankIndexの(val - 1)番目から値をとってくる
                // val - 1　は減算前の_VertCounter[1]、つまり現状の欠番の個数なのでインデックスは(val - 1)
                nvi = _BlankIndex[val - 1];
                //InterlockedAdd(_VertCounter[0], 1, nvi);
            }
            else {
                // 非正の場合，uint型なので0から減らしているとかなり大きな数になっている
                // 新たに頂点用のIDを発行する
                InterlockedAdd(_VertCounter[0], 1, nvi);// 現在のカウンタの値を新たな頂点のIDとしてから1を加算する
            }
            CloneVert(ep.vert, nvi);
            InterlockedAdd(_LockProcess[_VertBufferRW[nvi].orig], 1);   // このフレームではこのスレッド以外で頂点の操作を許さない

            int home_e;
            int tore_e;                             // すでに断裂していた稜線
            int tmp_e;
            float3 dR = float3(0, 0, 0);            // 右側方向
            float3 dL = float3(0, 0, 0);            // 左側方向
            int groupR[16];
            int countR = 0;
            int groupL[16];
            int countL = 0;

            // ep.vert周り
            home_e = ei.pair;                       //////////// ei.vertと違うところ ///////////
            tmp_e = home_e;
            // 反時計回り探索 groupRは断裂した稜線を含む
            do {
                if (_EdgeBufferRW[tmp_e].stat == 1) {
                    dR *= 0;
                    countR = 0;
                    break;
                }
                dR += _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos - _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
                if (tmp_e != home_e) {
                    groupR[countR++] = tmp_e;
                }

                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
            } while (_EdgeBufferRW[tmp_e].stat == 0);
            tore_e = tmp_e;
            if (_EdgeBufferRW[tore_e].pair != -1) {
                groupR[countR++] = tore_e;
                dR += _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos - _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
            }

            // 時計回り探索 さっき断裂した半稜線は含むが，断裂していた半稜線は含まない
            groupL[countL++] = home_e;
            tmp_e = _EdgeBufferRW[home_e].prev;

            while (_EdgeBufferRW[tmp_e].stat == 0) {
                if (_EdgeBufferRW[tmp_e].stat == 1) {
                    dL *= 0;
                    countL = 0;
                    break;
                }
                tmp_e = _EdgeBufferRW[tmp_e].pair;
                dL += _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos - _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
                groupL[countL++] = tmp_e;
                tmp_e = _EdgeBufferRW[tmp_e].prev;
            }
            dR = normalize(dR);
            dL = normalize(dL);

            if (countR == 0) {
                // edge.vertの付け替え
                _VertBufferRW[nvi].edge = groupL[0];
                for (int i = 0; i < countL; i++) {
                    SwapVertL(groupL[i], _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupL[i]].next, _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupL[i]].prev, _EdgeBufferRW[groupL[i]].vert, nvi);

                    SwapVertB(groupL[i], _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupL[i]].next, _EdgeBufferRW[groupL[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupL[i]].prev, _EdgeBufferRW[groupL[i]].vert, nvi);
                    _EdgeBufferRW[groupL[i]].vert = nvi;
                }
                if (dot(_gravity.xyz, dL) > 0) {
                    _VertBufferRW[nvi].rust += 100;// * dot(_gravity.xyz, dL);
                    if (_VertBufferRW[ep.vert].lowest) {
                        _VertBufferRW[ep.vert].lowest = false;
                        _VertBufferRW[nvi].lowest = true;
                    }
                }
                else {
                    _VertBufferRW[nvi].rust = _VertBufferRW[ep.vert].rust;
                    _VertBufferRW[ep.vert].rust += 100;// * dot(_gravity.xyz, -dL);
                    if (_VertBufferRW[ep.vert].lowest) {
                        _VertBufferRW[ep.vert].lowest = true;
                        _VertBufferRW[nvi].lowest = false;
                    }
                }
            }
            else {
                _VertBufferRW[nvi].edge = groupR[0];
                for (int i = 0; i < countR; i++) {
                    SwapVertL(groupR[i], _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupR[i]].next, _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertL(_EdgeBufferRW[groupR[i]].prev, _EdgeBufferRW[groupR[i]].vert, nvi);

                    SwapVertB(groupR[i], _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupR[i]].next, _EdgeBufferRW[groupR[i]].vert, nvi);
                    SwapVertB(_EdgeBufferRW[groupR[i]].prev, _EdgeBufferRW[groupR[i]].vert, nvi);
                    _EdgeBufferRW[groupR[i]].vert = nvi;
                }
                if (dot(_gravity.xyz, dR) > 0) {
                    _VertBufferRW[nvi].rust += 100;// * dot(_gravity.xyz, dR);
                    if (_VertBufferRW[ep.vert].lowest) {
                        _VertBufferRW[ep.vert].lowest = false;
                        _VertBufferRW[nvi].lowest = true;
                    }
                }
                else {
                    _VertBufferRW[nvi].rust = _VertBufferRW[ep.vert].rust;
                    _VertBufferRW[ep.vert].rust += 100;// * dot(_gravity.xyz, -dR);
                    if (_VertBufferRW[ep.vert].lowest) {
                        _VertBufferRW[ep.vert].lowest = true;
                        _VertBufferRW[nvi].lowest = false;
                    }
                }
            }
        } // ep.vertの頂点分割処理

        // 剥落判定
        if (_EdgeBufferRW[ei.next].stat > 0 && _EdgeBufferRW[ei.prev].stat > 0) {
            _LengthConstraintBufferRW[P_ID].thr = -1;
            _LengthConstraintBufferRW[ei.next].thr = -1;
            _LengthConstraintBufferRW[ei.prev].thr = -1;
            _FaceBufferRW[ei.face].stat = 1;
            _VertBufferRW[_EdgeBufferRW[P_ID].vert].pos = _VertBufferRW[_EdgeBufferRW[P_ID].vert].pos0;
            _VertBufferRW[_EdgeBufferRW[ei.next].vert].pos = _VertBufferRW[_EdgeBufferRW[ei.next].vert].pos0;
            _VertBufferRW[_EdgeBufferRW[ei.prev].vert].pos = _VertBufferRW[_EdgeBufferRW[ei.prev].vert].pos0;
        }
        // 剥落判定
        if (_EdgeBufferRW[ep.next].stat > 0 && _EdgeBufferRW[ep.prev].stat > 0) {
            _LengthConstraintBufferRW[ei.pair].thr = -1;
            _LengthConstraintBufferRW[ep.next].thr = -1;
            _LengthConstraintBufferRW[ep.prev].thr = -1;
            _FaceBufferRW[ep.face].stat = 1;
            _VertBufferRW[_EdgeBufferRW[ei.pair].vert].pos = _VertBufferRW[_EdgeBufferRW[ei.pair].vert].pos0;
            _VertBufferRW[_EdgeBufferRW[ep.next].vert].pos = _VertBufferRW[_EdgeBufferRW[ep.next].vert].pos0;
            _VertBufferRW[_EdgeBufferRW[ep.prev].vert].pos = _VertBufferRW[_EdgeBufferRW[ep.prev].vert].pos0;
        }
    }
    else {
        // 接合処理
        // 逆再生でなければ実行しない
        if (_delta_time > 0) return;
        crack = true;
        // 張力緩和前と結合力を比較
        if (tear_force / rp < bind_force && _VertBufferRW[ep.vert].stat != 2) {
            //_VertBufferRW[ep.vert].col = float4(0, 0, 1, 1);
            // 通常条件
            //crack = false;
        }
        if (crack && (_VertBufferRW[ei.vert].stat == 2 || ei.stat == 3)) {
            // 特殊条件 亀裂の端点だった場合，接合しにくい
            float3 ed = _VertBufferRW[ei.vert].pos - _VertBufferRW[ep.vert].pos;    // 断裂と逆方向であることに注意
            float rad = length(ed);
            ed /= rad;
            float cos = dot(_VertBufferRW[ei.vert].direction, ed);
            float sin = sqrt(1 - cos * cos);
            float cos1h = sqrt((1 + cos) / 2);
            float sin1h = sqrt((1 - cos) / 2);
            float sin3h = 3 * sin1h - 4 * sin1h * sin1h * sin1h;
            float cos3h = 4 * cos1h * cos1h * cos1h - 3 * cos1h;
            float sx = cos1h * (1 - sin1h * sin3h);
            float sy = cos1h * (1 + sin1h * sin3h);
            float sxy = cos1h * sin1h * cos3h;
            sx /= sqrt(rad);
            sy /= sqrt(rad);
            sxy /= sqrt(rad);
            float s = sy * cos * cos + sx * sin * sin - 2 * sxy * cos * sin;
            if (tear_force / rp * s * 1 < bind_force)
                crack = false;
        }
        if (crack && (_VertBufferRW[ep.vert].stat == 2 || ei.stat == 3)) {
            // 特殊条件 亀裂の端点だった場合
            float3 ed = _VertBufferRW[ep.vert].pos - _VertBufferRW[ei.vert].pos;
            float rad = length(ed);
            ed /= rad;
            float cos = dot(_VertBufferRW[ep.vert].direction, ed);
            float sin = sqrt(1 - cos * cos);
            float cos1h = sqrt((1 + cos) / 2);
            float sin1h = sqrt((1 - cos) / 2);
            float sin3h = 3 * sin1h - 4 * sin1h * sin1h * sin1h;
            float cos3h = 4 * cos1h * cos1h * cos1h - 3 * cos1h;
            float sx = cos1h * (1 - sin1h * sin3h);
            float sy = cos1h * (1 + sin1h * sin3h);
            float sxy = cos1h * sin1h * cos3h;
            sx /= sqrt(rad);
            sy /= sqrt(rad);
            sxy /= sqrt(rad);
            float s = sy * cos * cos + sx * sin * sin - 2 * sxy * cos * sin;
            if (tear_force / rp * s * 1 < bind_force)
                crack = false;
        }
        if (crack == false)
            ReconnectEdges(P_ID);
    }
    
}

#pragma kernel AdhereVert
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void AdhereVert
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    float w = 0.005;

    _VertBufferRW[P_ID].chalk += w * _delta_time;

}