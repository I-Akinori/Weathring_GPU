[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetVertices
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;

    _VertexBufferRW[P_ID].pos = _VertBufferRW[P_ID].pos;
    _VertexBufferRW[P_ID].nor = _VertBufferRW[P_ID].nor;
    _VertexBufferRW[P_ID].uv = _VertBufferRW[P_ID].uv;
    _VertexBufferRW[P_ID].col = _VertBufferRW[P_ID].col;
}


[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetTriangles
(
    uint3 DTid : SV_DispatchThreadID // スレッド全体で固有のID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _FaceNum) return;

    Edge tmp = _EdgeBufferRW[_FaceBufferRW[P_ID].edge];
    _TriangleBufferRW[P_ID * 3   ] = tmp.vert;
    tmp = _EdgeBufferRW[tmp.next];
    _TriangleBufferRW[P_ID * 3 + 1] = tmp.vert;
    tmp = _EdgeBufferRW[tmp.next];
    _TriangleBufferRW[P_ID * 3 + 2] = tmp.vert;
}