// Each #kernel tells which function to compile; you can have many kernels
#define SIMULATION_BLOCK_SIZE 256
#include "Elements.cginc"
#include "PerlinNoise.cginc"
// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture

uint _VertNum; // (フレーム実行前の) 頂点の数
uint _EdgeNum; // 稜線の数
uint _FaceNum; // 稜線の数
uint _LConstNum; // 長さ制約の数
uint _BConstNum; // 曲げ制約の数
float _delta_time;
uint _itr_count;
float length_ratio;
float4 _gravity;
float4 _hit_point;
uint _control_separation;   // 0: none, 1: weathering, 2: de-weathering
uint _control_tear;         // 0: none, 1: weathering, 2: de-weathering 
uint _control_stain;        // 0: none, 1: rust, 2: dust, 3: chalk, 4: wash
uint _blank_count;
float k1;
float k2;

StructuredBuffer<float3> _PositionBuffer;
StructuredBuffer<float3> _NormalBuffer;
RWStructuredBuffer<float3> _BasePositionBuffer;
RWStructuredBuffer<float3> _BaseNormalBuffer;
StructuredBuffer<float2> _UVBuffer;
RWStructuredBuffer<Vert> _VertBufferRW;
RWStructuredBuffer<Edge> _EdgeBufferRW;
RWStructuredBuffer<Face> _FaceBufferRW;
RWStructuredBuffer<Vertex> _VertexBufferRW;
RWStructuredBuffer<LengthConstraint> _LengthConstraintBufferRW;
RWStructuredBuffer<BendConstraint> _BendConstraintBufferRW;
RWStructuredBuffer<int> _TriangleBufferRW;
RWStructuredBuffer<uint3> _DeltaPosAsInt;
RWStructuredBuffer<uint> _DeltaCount;
RWStructuredBuffer<uint> _LiftingForceAsInt;
RWStructuredBuffer<uint> _LiftingForceCount;
RWStructuredBuffer<uint> _LockProcess; // 0: tear
RWStructuredBuffer<uint> _VertCounter; // カーネル実行中の変更を許す頂点カウンタ
RWStructuredBuffer<uint> _BlankIndex;

// helper function for atomic add
float FlowRust(uint source, uint target, uint path, float3 projected_grav) {
    Vert VS = _VertBufferRW[source];
    Vert VT = _VertBufferRW[target];
    float rust_thr = 0.1;
    float rust_thr2 = 0.45;
    float rust_ratio = 0.1;
    float val = 0;
    if (VS.onEdge == 0) {
        // 順伝搬の場合のみ，10未満の点から錆を受け取らない
        if (_delta_time > 0 && VS.rust < 10) 
            return 0;
        if (VS.rust < 100 || VS.lowest == 1) {
            float product = dot(normalize(VT.pos - VS.pos), projected_grav)
                / (1.0 + exp(-_EdgeBufferRW[path].angle)); // 曲率効果: 溝ほど流れやすい
            if (product > rust_thr) {
                val = product - rust_thr;
                if (product < rust_thr2)
                    val *= rust_ratio;
            }
        }
    }
    return val * _delta_time * 0.05;
}
void AtomicAddDelta(int indexIntoDeltaPos, float newDeltaVal, int axis) {
    uint i_val = asuint(newDeltaVal);
    uint tmp0 = 0;
    uint tmp1;

    [allow_uav_condition]
    while (true) {
        InterlockedCompareExchange(_DeltaPosAsInt[indexIntoDeltaPos][axis], tmp0, i_val, tmp1);

        if (tmp1 == tmp0) {
            break;
        }

        tmp0 = tmp1;
        i_val = asuint(newDeltaVal + asfloat(tmp1));
    }
    return;
}
void AtomicAddDeltaVector(int indexIntoDeltaPos, float3 newDeltaVal)
{
    InterlockedAdd(_DeltaCount[indexIntoDeltaPos], 1);
    AtomicAddDelta(indexIntoDeltaPos, newDeltaVal.x, 0);
    AtomicAddDelta(indexIntoDeltaPos, newDeltaVal.y, 1);
    AtomicAddDelta(indexIntoDeltaPos, newDeltaVal.z, 2);
    return;
}

void CloneVert(uint source, uint target) {
    _VertBufferRW[target].pos = _VertBufferRW[source].pos;
    _VertBufferRW[target].nor = _VertBufferRW[source].nor;
    _VertBufferRW[target].pos0 = _VertBufferRW[source].pos0;
    _VertBufferRW[target].nor0 = _VertBufferRW[source].nor0;

    _VertBufferRW[target].vel = _VertBufferRW[source].vel; // 無くても変わらない
    _VertBufferRW[target].ass = _VertBufferRW[source].ass; // 
    _VertBufferRW[target].frc = _VertBufferRW[source].frc; //
    _VertBufferRW[target].del = _VertBufferRW[source].del; //
    _VertBufferRW[target].w = _VertBufferRW[source].w;

    _VertBufferRW[target].dust = _VertBufferRW[source].dust;
    _VertBufferRW[target].rust = _VertBufferRW[source].rust;
    _VertBufferRW[target].chalk = _VertBufferRW[source].chalk;
    _VertBufferRW[target].bond = _VertBufferRW[source].bond;
    _VertBufferRW[target].onEdge = _VertBufferRW[source].onEdge;
    _VertBufferRW[target].stat = _VertBufferRW[source].stat;
    _VertBufferRW[target].uv = _VertBufferRW[source].uv;
    _VertBufferRW[target].col = _VertBufferRW[source].col;
    _VertBufferRW[target].orig = _VertBufferRW[source].orig;
    _VertBufferRW[target].edge = _VertBufferRW[source].edge;
}

void SwapVertL(uint id, uint before, uint after) {
    if (_LengthConstraintBufferRW[id].p0 == before) _LengthConstraintBufferRW[id].p0 = after;
    if (_LengthConstraintBufferRW[id].p1 == before) _LengthConstraintBufferRW[id].p1 = after;
}
void SwapVertB(uint id, uint before, uint after) {
    if (_BendConstraintBufferRW[id].p0 == before) _BendConstraintBufferRW[id].p0 = after;
    if (_BendConstraintBufferRW[id].p1 == before) _BendConstraintBufferRW[id].p1 = after;
    if (_BendConstraintBufferRW[id].p2 == before) _BendConstraintBufferRW[id].p2 = after;
    if (_BendConstraintBufferRW[id].p3 == before) _BendConstraintBufferRW[id].p3 = after;
}
void SwapVertL_onEdge(uint id, uint before, uint after) {
    SwapVertL(id, before, after);
    if (_EdgeBufferRW[id].stat != 1) SwapVertL(_EdgeBufferRW[id].pair, before, after);
}
void SwapVertB_onEdge(uint id, uint before, uint after) {
    SwapVertB(id, before, after);
    if (_EdgeBufferRW[id].stat != 1) SwapVertB(_EdgeBufferRW[id].pair, before, after);
}
void ReattachVertex(uint id) {
    if (_VertBufferRW[id].stat == 1)
        _VertBufferRW[id].stat = 0;
    _VertBufferRW[id].pos = _VertBufferRW[id].pos0;
    _VertBufferRW[id].nor = _VertBufferRW[id].nor0;
    _VertBufferRW[id].w = 0;
    _VertBufferRW[id].lowest = 0;
}
void ReconnectEdges(uint id) {
    if (_EdgeBufferRW[id].stat != 2 && _EdgeBufferRW[id].stat != 3)
        return;
    
    uint val1 = 3;
    InterlockedCompareExchange(_LockProcess[_VertBufferRW[_EdgeBufferRW[id].vert].orig], 0, 1, val1);
    uint val2 = 3;
    InterlockedCompareExchange(_LockProcess[_VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[id].pair].vert].orig], 0, 1, val2);

    if (val1 == 0 && val2 == 0) {
        _EdgeBufferRW[id].stat = 0; _EdgeBufferRW[_EdgeBufferRW[id].pair].stat = 0;
        // 断裂前稜線の長さ制約は片方だけ
        if (id < _EdgeBufferRW[id].pair) {
            _LengthConstraintBufferRW[id].thr = 0.001;
            _LengthConstraintBufferRW[_EdgeBufferRW[id].pair].thr = -1;
            _BendConstraintBufferRW[id].thr = 0.001; 
            _BendConstraintBufferRW[_EdgeBufferRW[id].pair].thr = -1;

        }
        else {
            _LengthConstraintBufferRW[_EdgeBufferRW[id].pair].thr = -1;
            _LengthConstraintBufferRW[id].thr = 0.001;
            _BendConstraintBufferRW[_EdgeBufferRW[id].pair].thr = 0.001;
            _BendConstraintBufferRW[id].thr = -1;
        }
        
        uint ev = _EdgeBufferRW[id].vert;
        uint epnv = _EdgeBufferRW[_EdgeBufferRW[_EdgeBufferRW[id].pair].next].vert;

        //if (ev == epnv) return;
        // stat == 3 で塗膜片 2枚: stat > 3 のときは繋げても塗膜片が分断されたままになる
        // そのため向かい側まで頂点のstatを更新しなくてはならない
        // またstat > 2 のときは分かれた頂点が stat - 1 > 1 個あって statの値がバラバラの可能性がある
        // たとえば... 亀裂端点 (2) → 分断直後 (3, 3) → さらに分断 (3, 4, 4) → さらにさらに分断 (3, 5, 5, 4)
        // なので現状を把握するにはstatの最大値を探索する必要が出てくる
        if (_VertBufferRW[ev].stat > 2)
        {
            uint home_e = id;
            uint tmp_e = _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next;
            uint vertex_list[16];
            uint count = 0;
            uint debug_counter = 0;

            vertex_list[count++] = _EdgeBufferRW[tmp_e].vert;   // epnv
            do {
                // 違う頂点を発見
                if (_EdgeBufferRW[tmp_e].vert != vertex_list[count - 1]) {
                    vertex_list[count++] = _EdgeBufferRW[tmp_e].vert;
                }

                if (_EdgeBufferRW[tmp_e].stat == 1) {
                    vertex_list[count++] = _EdgeBufferRW[home_e].vert;
                    tmp_e = home_e;
                    while (_EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].stat == 1) {
                        if (_EdgeBufferRW[tmp_e].vert != vertex_list[count - 1]) {
                            vertex_list[count++] = _EdgeBufferRW[tmp_e].vert;
                        }
                        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].pair;
                    }
                    break;
                }
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
                if (debug_counter++ > 64) {
                    _VertBufferRW[ev].stat = 64;
                    break;
                };
            } while (tmp_e != _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next);

            for (uint i = 0; i < count; i++) {
                // statはすべて頂点数(亀裂数) に
                // statは亀裂数 + 1が保存されるが、この後に亀裂が1本減るので+1は要らない
                _VertBufferRW[vertex_list[i]].stat = count;
            }

            // 頂点情報の更新 ev or epnvどちらかを欠番に登録 & 現状のstatを32に
            if (_VertBufferRW[ev].orig == ev) {
                // evがオリジナルなので、epnvの方を無効化
                // 反時計回り探索
                _VertBufferRW[epnv].stat = 32;
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next;
                uint idx;
                InterlockedAdd(_VertCounter[1], 1, idx);
                _BlankIndex[idx] = epnv;

                // 欠番につながる頂点をevに付け替え
                do {
                    SwapVertL(tmp_e, epnv, ev);
                    SwapVertL(_EdgeBufferRW[tmp_e].prev, epnv, ev);
                    SwapVertL(_EdgeBufferRW[tmp_e].next, epnv, ev);
                    SwapVertB(tmp_e, epnv, ev);
                    SwapVertB(_EdgeBufferRW[tmp_e].prev, epnv, ev);
                    SwapVertB(_EdgeBufferRW[tmp_e].next, epnv, ev);

                    _EdgeBufferRW[tmp_e].vert = ev;
                    if (_EdgeBufferRW[tmp_e].stat > 0) { 
                        // 亀裂の端点なら方向を記録
                        if (_VertBufferRW[ev].stat == 2)
                        {
                            _VertBufferRW[ev].direction = normalize(_VertBufferRW[ev].pos - _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos);
                        }
                        break; 
                    }
                    if (debug_counter++ > 64) {
                        _VertBufferRW[ev].stat = 64;
                        break;
                    };
                    tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;

                } while (tmp_e != _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next);
                // 錆関係の更新
                _VertBufferRW[ev].lowest = 0;
                //_VertBufferRW[ev].rust = 0;
            }
            else {
                // epnvがオリジナルの可能性があるので、evの方を無効化する
                // 時計回り探索
                _VertBufferRW[ev].stat = 32;
                tmp_e = home_e;
                uint idx;
                InterlockedAdd(_VertCounter[1], 1, idx);
                _BlankIndex[idx] = ev;

                // 欠番につながる頂点をepnvに付け替え
                do {
                    SwapVertL(tmp_e, ev, epnv);
                    SwapVertL(_EdgeBufferRW[tmp_e].prev, ev, epnv);
                    SwapVertL(_EdgeBufferRW[tmp_e].next, ev, epnv);
                    SwapVertB(tmp_e, ev, epnv);
                    SwapVertB(_EdgeBufferRW[tmp_e].prev, ev, epnv);
                    SwapVertB(_EdgeBufferRW[tmp_e].next, ev, epnv);
                    _EdgeBufferRW[tmp_e].vert = epnv;
                    if (_EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].stat > 0) { 
                        // 亀裂の端点なら方向を記録
                        if (_VertBufferRW[epnv].stat == 2)
                        {
                            _VertBufferRW[epnv].direction = normalize(_VertBufferRW[epnv].pos - _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].vert].pos);
                        }
                        break; 
                    }
                    if (debug_counter++ > 64) {
                        _VertBufferRW[epnv].stat = 64;
                        break;
                    };
                    tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].pair;

                } while (tmp_e != home_e);
                // 錆関係の更新
                _VertBufferRW[epnv].lowest = 0;
                //_VertBufferRW[epnv].rust = 0;
            }

        }
        else {
            // 亀裂の端点は修復後元に戻す
            _VertBufferRW[ev].stat = 0;
            _VertBufferRW[ev].lowest = 0;
            //_VertBufferRW[ev].rust = 0;
        }
        // 剥落の復元
        // 現在の使い方では，stat = 0 である面の周りしかreconnectしないので意味はない
        if (_FaceBufferRW[_EdgeBufferRW[id].face].stat == 1) {
            _FaceBufferRW[_EdgeBufferRW[id].face].stat = 0;
            _LengthConstraintBufferRW[_EdgeBufferRW[id].next].thr = 0.001;
            _LengthConstraintBufferRW[_EdgeBufferRW[id].prev].thr = 0.001;
        };

        _EdgeBufferRW[id].stat = 0; _EdgeBufferRW[_EdgeBufferRW[id].pair].stat = 0;
        uint epv = _EdgeBufferRW[_EdgeBufferRW[id].pair].vert;
        uint env = _EdgeBufferRW[_EdgeBufferRW[id].next].vert;

        //if (ev == epnv) return;
        // stat == 3 で塗膜片 2枚: stat > 3 のときは繋げても塗膜片が分断されたままになる
        // そのため向かい側まで頂点のstatを更新しなくてはならない
        // またstat > 2 のときは分かれた頂点が stat - 1 > 1 個あって statの値がバラバラの可能性がある
        // たとえば... 亀裂端点 (2) → 分断直後 (3, 3) → さらに分断 (3, 4, 4) → さらにさらに分断 (3, 5, 5, 4)
        // なので現状を把握するにはstatの最大値を探索する必要が出てくる
        if (_VertBufferRW[epv].stat > 2)
        {
            uint home_e = _EdgeBufferRW[id].pair;
            uint tmp_e = _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next;
            uint vertex_list[16];
            uint count = 0;
            uint debug_counter = 0;

            vertex_list[count++] = _EdgeBufferRW[tmp_e].vert;   // env
            do {
                // 違う頂点を発見
                if (_EdgeBufferRW[tmp_e].vert != vertex_list[count - 1]) {
                    vertex_list[count++] = _EdgeBufferRW[tmp_e].vert;
                }

                if (_EdgeBufferRW[tmp_e].stat == 1) {
                    vertex_list[count++] = _EdgeBufferRW[home_e].vert;
                    tmp_e = home_e;
                    while (_EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].stat == 1) {
                        if (_EdgeBufferRW[tmp_e].vert != vertex_list[count - 1]) {
                            vertex_list[count++] = _EdgeBufferRW[tmp_e].vert;
                        }
                        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].pair;
                    }
                    break;
                }
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
                if (debug_counter++ > 64) {
                    _VertBufferRW[ev].stat = 64;
                    break;
                };
            } while (tmp_e != _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next);

            for (uint i = 0; i < count; i++) {
                // statはすべて頂点数 (亀裂数) に
                // statは亀裂数 + 1が保存されるが、この後に亀裂が1本減るので+1は要らない
                _VertBufferRW[vertex_list[i]].stat = count;
            }

            // 頂点情報の更新 ev or epnvどちらかを欠番に登録 & 現状のstatを32に
            if (_VertBufferRW[epv].orig == epv) {
                // epvがオリジナルなので、envの方を無効化
                // 反時計回り探索
                _VertBufferRW[env].stat = 32;
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next;
                uint idx;
                InterlockedAdd(_VertCounter[1], 1, idx);
                _BlankIndex[idx] = env;

                // 欠番につながる頂点をepvに付け替え
                do {
                    SwapVertL(tmp_e, env, epv);
                    SwapVertL(_EdgeBufferRW[tmp_e].prev, env, epv);
                    SwapVertL(_EdgeBufferRW[tmp_e].next, env, epv);
                    SwapVertB(tmp_e, env, epv);
                    SwapVertB(_EdgeBufferRW[tmp_e].prev, env, epv);
                    SwapVertB(_EdgeBufferRW[tmp_e].next, env, epv);
                    _EdgeBufferRW[tmp_e].vert = epv;

                    if (_EdgeBufferRW[tmp_e].stat > 0) { 
                        // 亀裂の端点なら方向を記録
                        if (_VertBufferRW[epv].stat == 2) 
                        {
                            _VertBufferRW[epv].direction = normalize(_VertBufferRW[epv].pos - _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos);
                        }
                        break; 
                    }
                    if (debug_counter++ > 64) {
                        _VertBufferRW[epv].stat = 64;
                        break;
                    };
                    tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;

                } while (tmp_e != _EdgeBufferRW[_EdgeBufferRW[home_e].pair].next);
                
                // 錆関係の更新
                _VertBufferRW[epv].lowest = 0;
                //_VertBufferRW[epv].rust = 0;
            }
            else {
                // envがオリジナルの可能性があるので、epvの方を無効化する
                // 時計回り探索
                _VertBufferRW[epv].stat = 32;
                tmp_e = home_e;
                uint idx;
                InterlockedAdd(_VertCounter[1], 1, idx);
                _BlankIndex[idx] = epv;

                // 欠番につながる頂点をenvに付け替え
                do {
                    SwapVertL(tmp_e, epv, env);
                    SwapVertL(_EdgeBufferRW[tmp_e].prev, epv, env);
                    SwapVertL(_EdgeBufferRW[tmp_e].next, epv, env);
                    SwapVertB(tmp_e, epv, env);
                    SwapVertB(_EdgeBufferRW[tmp_e].prev, epv, env);
                    SwapVertB(_EdgeBufferRW[tmp_e].next, epv, env);
                    _EdgeBufferRW[tmp_e].vert = env;
                    if (_EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].stat > 0) { 
                        // 亀裂の端点なら方向を記録
                        if (_VertBufferRW[env].stat == 2)
                        {
                            _VertBufferRW[env].direction = normalize(_VertBufferRW[env].pos - _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].vert].pos);
                        }
                        break; 
                    }
                    if (debug_counter++ > 64) {
                        _VertBufferRW[env].stat = 64;
                        break;
                    };
                    tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].pair;

                } while (tmp_e != home_e);

                // 錆関係の更新
                _VertBufferRW[env].lowest = 0;
                //_VertBufferRW[env].rust = 0;
            }
        }
        else {
            // 亀裂の端点は修復後元に戻す
            _VertBufferRW[epv].stat = 0;
            _VertBufferRW[epv].lowest = 0;
            //_VertBufferRW[epv].rust = 0;
        }
        // 剥落の復元
        if (_FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[id].pair].face].stat == 1) {
            _FaceBufferRW[_EdgeBufferRW[_EdgeBufferRW[id].pair].face].stat = 0;
            _LengthConstraintBufferRW[_EdgeBufferRW[_EdgeBufferRW[id].pair].next].thr = 0.001;
            _LengthConstraintBufferRW[_EdgeBufferRW[_EdgeBufferRW[id].pair].prev].thr = 0.001;
        };
    }
}
void ControlStain(uint id) {
    _VertBufferRW[id].rust -= _VertBufferRW[id].rust * 0.1;
    _VertBufferRW[id].dust -= _VertBufferRW[id].dust * 0.1;
    _VertBufferRW[id].chalk -= _VertBufferRW[id].chalk * 0.1;
}

#pragma kernel InitVert
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void InitVert
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;

    _VertBufferRW[P_ID].pos = _PositionBuffer[P_ID];
    _VertBufferRW[P_ID].nor = _NormalBuffer[P_ID];
    
    _VertBufferRW[P_ID].pos0 = _PositionBuffer[P_ID];
    _VertBufferRW[P_ID].nor0 = _NormalBuffer[P_ID];

    _VertBufferRW[P_ID].vel = float3(0, 0, 0);
    _VertBufferRW[P_ID].ass = _PositionBuffer[P_ID];
    _VertBufferRW[P_ID].frc = float3(0, 0, 0);
    _VertBufferRW[P_ID].del = float3(0, 0, 0);
    _VertBufferRW[P_ID].w = 0;

    _VertBufferRW[P_ID].frc = float3(0, 0, 0);
    _VertBufferRW[P_ID].dust = 0;
    _VertBufferRW[P_ID].rust = 0;
    _VertBufferRW[P_ID].rust_buf = 0;
    _VertBufferRW[P_ID].chalk = 0;
    _VertBufferRW[P_ID].bond = OctavePerlin(_VertBufferRW[P_ID].pos * 1 + float3(100, 200, 300), 5, 0.5) * 400 - 100;
    _VertBufferRW[P_ID].onEdge = 0;
    _VertBufferRW[P_ID].stat = 0;
    _VertBufferRW[P_ID].orig = P_ID;

    _VertBufferRW[P_ID].uv = _UVBuffer[P_ID];

    //_VertBufferRW[P_ID].edge = -1;

    float rand = frac(sin(dot(_VertBufferRW[P_ID].pos, float3(12.9898, 78.233, 43.622))) * 43758.5453);
    //_VertBufferRW[P_ID].col = float4(OctavePerlin(_VertBufferRW[P_ID].pos) * (rand < 0.001 ? 0.01 : 1.0), 0, 0, 1);
    
    if (_VertBufferRW[P_ID].pos0.y > 4.9 || _VertBufferRW[P_ID].pos0.y < -4.9 || _VertBufferRW[P_ID].pos0.x > 4.9 || _VertBufferRW[P_ID].pos0.x < -4.9) {
        //_VertBufferRW[P_ID].w = 0;
        //_VertBufferRW[P_ID].col = float4(0, 0, 1, 1);
        //_VertBufferRW[P_ID].frc += float3(0, _VertBufferRW[P_ID].pos0.y - 4, 0) * 0.01;
        //_VertBufferRW[P_ID].w = 1.0;
    }
}

#pragma kernel InitEdge
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void InitEdge
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _FaceNum) return;

    for (uint j = 0; j < 3; j++) {
        _EdgeBufferRW[P_ID * 3 + j].next = P_ID * 3 + (j + 1) % 3;
        _EdgeBufferRW[P_ID * 3 + j].prev = P_ID * 3 + (j + 2) % 3;
        _EdgeBufferRW[P_ID * 3 + j].vert = _TriangleBufferRW[P_ID * 3 + j];
        _EdgeBufferRW[P_ID * 3 + j].face = P_ID;
        _EdgeBufferRW[P_ID * 3 + j].pair = -1;
        _EdgeBufferRW[P_ID * 3 + j].stat = 1;
        _VertBufferRW[_EdgeBufferRW[P_ID * 3 + j].vert].edge = P_ID * 3 + j;

        float3 mid_p = _VertBufferRW[_EdgeBufferRW[P_ID * 3 + j].vert].pos;
        mid_p += _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[P_ID * 3 + j].next].vert].pos;
        mid_p *= 0.5;

        float rand = frac(sin(dot(mid_p, float3(12.9898, 78.233, 43.622))) * 43758.5453);
        _EdgeBufferRW[P_ID * 3 + j].bindingForce = (OctavePerlin(mid_p, 5, 0.5) * 500 + 500) * (rand < 0.001 ? 0.01 : 1.0);
    }
}

#pragma kernel InitFace
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void InitFace
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _FaceNum) return;

    _FaceBufferRW[P_ID].edge = P_ID * 3;
    _FaceBufferRW[P_ID].stat = 0;
    _FaceBufferRW[P_ID].contraction = 100;
    _FaceBufferRW[P_ID].tension = 100;
}

#pragma kernel SetPair
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetPair
(
	uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _EdgeNum) return;

    Edge e0 = _EdgeBufferRW[P_ID];
    // SIMULATION_BLOCK_SIZE（グループスレッド数）ごとの実行 (グループ数分実行)
	[loop]
	for (uint i = 0; i < (uint)_EdgeNum; i++)
	{
        Edge e1 = _EdgeBufferRW[i];
        if (e0.vert == _EdgeBufferRW[e1.next].vert && e1.vert == _EdgeBufferRW[e0.next].vert) {
            _EdgeBufferRW[P_ID].pair = asint(i);
            _EdgeBufferRW[P_ID].stat = 0;
            break;
        }
	}
    if (_EdgeBufferRW[P_ID].stat == 1)
        _VertBufferRW[_EdgeBufferRW[P_ID].vert].onEdge = 1;
}
#pragma kernel SetBase
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetBase
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;

    _BasePositionBuffer[P_ID] -= _BaseNormalBuffer[P_ID] * 0.01;
}
#pragma kernel ComputeVertCurvature
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void ComputeVertCurvature
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    int home_e = _VertBufferRW[P_ID].edge;
    int tmp_e = home_e;
    uint count = 0;
    //float sum_l_a = 0;
    //float sum_angle = 0;
    float sum_area = 0;
    float3 sum_k = float3(0, 0, 0);
    const float PI = 3.14159;

    do {
        // 反時計回り
        if (_EdgeBufferRW[tmp_e].stat == 1) {
            return;
            // モデルの縁に来たら時計回り
            tmp_e = _EdgeBufferRW[home_e].prev;

            while (_EdgeBufferRW[tmp_e].pair != -1) {
               tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
               count++;

            }
            count++; // 縁の分
            break;
        }
        float3 v0 = _VertBufferRW[_EdgeBufferRW[tmp_e].vert].pos;
        float3 v1 = _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].pos;
        float3 v2 = _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].prev].vert].pos;
        float3 v3 = _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev].vert].pos;
        
        //float3 n0 = normalize(cross(v1 - v0, v2 - v0));
        //float3 n1 = normalize(cross(v1 - v0, v3 - v0));
        float cosA = dot(normalize(v0 - v2), normalize(v1 - v2));
        float cosB = dot(normalize(v0 - v3), normalize(v1 - v3));
        float cotA = sqrt(cosA * cosA / (1 - cosA * cosA)) * sign(cosA);
        float cotB = sqrt(cosB * cosB / (1 - cosB * cosB)) * sign(cosB);
        sum_k += (cotA + cotB) * (v1 - v0);

        //if (true) { _VertBufferRW[P_ID].col = float4(1, 0, 0, 1); return; }
        if (length(v1 - v0) == 0) { return; }
        
        sum_area += length(cross(v1 - v0, v2 - v0)) / 2;
        //float angle = acos(clamp(dot(n0, n1), -1, 1));
        //angle = dot(cross(v1 - v0, v2 - v0), v3 - v0) < 0 ? angle : 2 * PI - angle;
        //sum_angle += angle;
        //sum_l_a += length(v1 - v0) * angle;
        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
        count++;
        
    } while (tmp_e != home_e);
    
    //float val = (sum_angle / count) / (2 * PI);
    //if (val > 0.5)
    //    _VertBufferRW[P_ID].col = float4(0, 0, 1, 0) * (val - 0.5) * 16 + float4(0, 0, 0, 1);
    //else
    //    _VertBufferRW[P_ID].col = float4(1, 0, 0, 0) * (0.5 - val) * 16 + float4(0, 0, 0, 1);

    //float V = (sum_l_a / 4) / (sum_area / 3) / (2 * PI) * 0.015;
    //if (V > 0.5)
    //    _VertBufferRW[P_ID].col = float4(0, 0, 1, 0) * (V - 0.5) * 8 + float4(0, 0, 0, 1);
    //else
    //    _VertBufferRW[P_ID].col = float4(1, 0, 0, 0) * (0.5 - V) * 8 + float4(0, 0, 0, 1);
    
    float K = sign(dot(sum_k, _VertBufferRW[P_ID].nor)) * (length(sum_k) / 4) / (sum_area / 3) / (2 * PI);
    //if (K > 0)
    //    _VertBufferRW[P_ID].col = float4(0, 0, 1, 1) * (K) + float4(0, 1, 0, 1) * (1 - K);
    //else
    //    _VertBufferRW[P_ID].col = float4(1, 0, 0, 1) * (- K) + float4(0, 1, 0, 1) * (1 + K);
    _VertBufferRW[P_ID].cur = sign(dot(sum_k, _VertBufferRW[P_ID].nor)) * (length(sum_k) / 4) / (sum_area / 3);
}
#pragma kernel ComputeEdgeCurvature
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void ComputeEdgeCurvature
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _EdgeNum) return;

    const float PI = 3.14159;
    if (_EdgeBufferRW[P_ID].stat > 0) {
        _EdgeBufferRW[P_ID].angle = 0;
        return;
    }

    int home_e = _VertBufferRW[P_ID].edge;
    int tmp_e = home_e;

    float3 v0 = _VertBufferRW[_EdgeBufferRW[P_ID].vert].pos;
    float3 v1 = _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[P_ID].next].vert].pos;
    float3 v2 = _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[P_ID].prev].vert].pos;
    float3 v3 = _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[_EdgeBufferRW[P_ID].pair].prev].vert].pos;

    float3 n0 = normalize(cross(v1 - v0, v2 - v0));
    float3 n1 = normalize(cross(v1 - v0, v3 - v0));
    float angle = acos(clamp(dot(n0, n1), -1, 1));
    
    _EdgeBufferRW[P_ID].angle = dot(cross(v1 - v0, v2 - v0), v3 - v0) > 0 ? angle - PI : PI - angle;
}
#pragma kernel ProceedChalking
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void ProceedChalking
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    float w = 0.005;

    _VertBufferRW[P_ID].chalk += w * _delta_time;
    if (_VertBufferRW[P_ID].chalk < 0) _VertBufferRW[P_ID].chalk = 0;

}
#pragma kernel AccumulateDust
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void AccumulateDust
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    int home_e = _VertBufferRW[P_ID].edge;
    int tmp_e = home_e;
    const float PI = 3.14159;
    
    float w = 0.0002;
    float w_normal = 4.0;
    float w_curvat = 1.0;
    
    _VertBufferRW[P_ID].dust += w * (1.0 + w_normal / (1.0 + exp(10 * asin(dot(_VertBufferRW[P_ID].nor, float3(0, -1, 0)))) ) + w_curvat / (1.0 + exp(-_VertBufferRW[P_ID].cur))) * _delta_time;
    if (_VertBufferRW[P_ID].dust < 0) _VertBufferRW[P_ID].dust = 0;
}
#pragma kernel SetRustBuffer
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SetRustBuffer
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    _VertBufferRW[P_ID].rust_buf = min(_VertBufferRW[P_ID].rust, 100);
}
#pragma kernel PropagateRust
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void PropagateRust
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _VertNum) return;
    if (_VertBufferRW[P_ID].stat == 32) return;

    int home_e = _VertBufferRW[P_ID].edge;
    int tmp_e = home_e;
    const float PI = 3.14159;
    // 最大流れ方向
    float3 projected_grav = normalize(_gravity.xyz - dot(_VertBufferRW[P_ID].nor, _gravity.xyz) * _VertBufferRW[P_ID].nor);

    do {
        // 反時計回り: tmp_eは頂点から出る方向
        // 反時計回り処理: すべてのtmp_e
        _VertBufferRW[P_ID].rust +=
            FlowRust(_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert, P_ID, tmp_e, projected_grav) * 
            _VertBufferRW[_EdgeBufferRW[_EdgeBufferRW[tmp_e].next].vert].rust_buf;

        if (_EdgeBufferRW[tmp_e].stat > 0) {
            // 反時計回処理: 断裂したtmp_e
            // モデルの縁に来た
            tmp_e = _EdgeBufferRW[home_e].prev;
            while (_EdgeBufferRW[tmp_e].stat == 0) {
                _VertBufferRW[P_ID].rust +=
                    FlowRust(_EdgeBufferRW[tmp_e].vert, P_ID, tmp_e, projected_grav) *
                    _VertBufferRW[_EdgeBufferRW[tmp_e].vert].rust_buf;

                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;

            }
            // 時計回り処理: 断裂したtmp_e
            _VertBufferRW[P_ID].rust +=
                FlowRust(_EdgeBufferRW[tmp_e].vert, P_ID, tmp_e, projected_grav) *
                _VertBufferRW[_EdgeBufferRW[tmp_e].vert].rust_buf;
            break;
        }
        // 反時計回り処理: 断裂したtmp_e 

        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
    } while (tmp_e != home_e);
    // 逆再生時は無条件で少し減る
    if (_delta_time < 0)
        _VertBufferRW[P_ID].rust += _delta_time * 0.2;

    if (_VertBufferRW[P_ID].rust > 100) _VertBufferRW[P_ID].rust = 100;
    if (_VertBufferRW[P_ID].rust < 0) _VertBufferRW[P_ID].rust = 0;
}

#pragma kernel SearchAroundVertex_Template
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void SearchAroundVertex_Template
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    int home_e = _VertBufferRW[P_ID].edge;
    int tmp_e = home_e;
    uint count = 0;

    do {
        // 反時計回り: tmp_eは頂点から出る方向
        // 反時計回り処理: すべてのtmp_e

        if (_EdgeBufferRW[tmp_e].stat == 1) {
            // 反時計回処理: ペア存在しないtmp_e
            // モデルの縁に来た

            tmp_e = _EdgeBufferRW[home_e].prev;
            while (_EdgeBufferRW[tmp_e].pair != -1) {
                // 時計回り: tmp_eは頂点に向かう方向
                // 時計回り処理: すべてのtmp_e
                tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].prev;
                count++;
                if (count > 100) break;
            }
            // 時計回り処理: ペアが存在しないtmp_e
            break;
        }
        // 反時計回り処理: ペアが存在しているtmp_e 
        
        tmp_e = _EdgeBufferRW[_EdgeBufferRW[tmp_e].pair].next;
        count++;

        if (count > 100) break;
    } while (tmp_e != home_e);

    //_VertBufferRW[P_ID].col = float4(count * 0.1, count * 0.1, count * 0.1, 1);
}

#pragma kernel TestPBD
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void TestPBD
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _EdgeNum) return;

    uint p = _EdgeBufferRW[P_ID].pair;
    _LengthConstraintBufferRW[P_ID].p0 = _EdgeBufferRW[P_ID].vert;
    _LengthConstraintBufferRW[P_ID].p1 = _EdgeBufferRW[_EdgeBufferRW[P_ID].next].vert;
    _LengthConstraintBufferRW[P_ID].stiff = 1;
    _LengthConstraintBufferRW[P_ID].offset = length(_VertBufferRW[_LengthConstraintBufferRW[P_ID].p0].pos - _VertBufferRW[_LengthConstraintBufferRW[P_ID].p1].pos);
    _LengthConstraintBufferRW[P_ID].offset0 = length(_VertBufferRW[_LengthConstraintBufferRW[P_ID].p0].pos0 - _VertBufferRW[_LengthConstraintBufferRW[P_ID].p1].pos0);

    if (p != -1 || (int)P_ID < p) {
        _LengthConstraintBufferRW[P_ID].thr = 0.001;
    }
    else {
        _LengthConstraintBufferRW[P_ID].thr = -1;
    }
    _BendConstraintBufferRW[P_ID].p0 = _EdgeBufferRW[_EdgeBufferRW[P_ID].pair].vert;//_EdgeBufferRW[_EdgeBufferRW[P_ID].pair].vert;
    _BendConstraintBufferRW[P_ID].p1 = _EdgeBufferRW[P_ID].vert; 
    _BendConstraintBufferRW[P_ID].p2 = _EdgeBufferRW[_EdgeBufferRW[P_ID].prev].vert;
    _BendConstraintBufferRW[P_ID].p3 = _EdgeBufferRW[_EdgeBufferRW[_EdgeBufferRW[P_ID].pair].prev].vert;
    _BendConstraintBufferRW[P_ID].stiff = 0.95;
    _BendConstraintBufferRW[P_ID].offset = - sin(_EdgeBufferRW[P_ID].angle / 2);// *abs(dot(normalize(_VertBufferRW[_BendConstraintBufferRW[P_ID].p0].pos - _VertBufferRW[_BendConstraintBufferRW[P_ID].p1].pos), float3(1, 0, 0)));
    _BendConstraintBufferRW[P_ID].offset0 = - sin(_EdgeBufferRW[P_ID].angle / 2);
    if (p != -1 && (int)P_ID < p) {
        _BendConstraintBufferRW[P_ID].thr = 0.001;
    }
    else {
        _BendConstraintBufferRW[P_ID].thr = -1;
    }
}

#pragma kernel PBD_UpdateConstraint
[numthreads(SIMULATION_BLOCK_SIZE, 1, 1)]
void PBD_UpdateConstraint
(
    uint3 DTid : SV_DispatchThreadID
)
{
    const unsigned int P_ID = DTid.x;
    if (P_ID >= _EdgeNum) return;

    //_LengthConstraintBufferRW[P_ID].offset = _LengthConstraintBufferRW[P_ID].offset0 * (1.0 - _FaceBufferRW[_EdgeBufferRW[P_ID].face].contraction * 0.0001);
    //_BendConstraintBufferRW[P_ID].offset = _BendConstraintBufferRW[P_ID].offset0 + _FaceBufferRW[_EdgeBufferRW[P_ID].face].contraction * 0.001;
